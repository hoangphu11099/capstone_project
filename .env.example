DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=student_manager_db

PORT=8080

# Set a private random value of at least 32 characters. Never commit the real key.
JWT_SECRET=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Leave empty for direct local access. Set only real reverse proxy IPs/CIDRs.
TRUSTED_PROXIES=

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
